# Copy this file to .env and fill it in. .env is git-ignored.

# Which model provider the chat uses: openrouter or gemini.
# If this is left out, the app uses OpenRouter when that is the only key set, otherwise Gemini.
LLM_PROVIDER=openrouter

# OpenRouter. Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling (see openrouter.ai/models and filter on "tools").
# A model ending in :free costs nothing but has tight rate limits and changes often.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Gemini, if LLM_PROVIDER=gemini. Key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change over time; check the Gemini API docs if this one stops working.
GEMINI_MODEL=gemini-3.5-flash

# Where the GlobeTrot landing page runs (used for the links in the chat header).
SITE_URL=http://localhost:5173

# HTTP API (api.py). Optional: where contact-form messages are appended, and the log level.
# CONTACT_FILE=data/contact_messages.jsonl
# LOG_LEVEL=INFO
